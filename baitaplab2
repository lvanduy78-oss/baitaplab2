let n = Number(prompt("Nhập một số nguyên:"));
let laSoNguyenTo = true;

if (!Number.isInteger(n) || n < 2) {
    laSoNguyenTo = false;
} else {
    for (let i = 2; i < n; i++) {
        if (n % i == 0) {
            laSoNguyenTo = false;
            break;
        }
    }
}

if (laSoNguyenTo) {
    alert(n + " là số nguyên tố");
} else {
    alert(n + " không phải là số nguyên tố");
}
